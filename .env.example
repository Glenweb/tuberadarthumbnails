# ─────────────────────────────────────────────────────────────────────────────
# TubeRadar Thumbnails — environment
#
# EVERY key below is OPTIONAL. With none of them set the module runs in
# "Local Studio" mode: procedural thumbnail synthesis, heuristic title
# generation and the full deterministic scoring engine, all offline.
# Add keys to light up the live providers one at a time — /api/health reports
# exactly which capabilities are active.
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic Claude — title generation, thumbnail concepts, pair critique ──
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5-5.
TRT_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (defaults to medium)
TRT_CLAUDE_EFFORT=medium

# ── Google AI Studio (Gemini) — thumbnail image generation ──────────────────
GEMINI_API_KEY=
# Defaults to gemini-3-pro-image, falls back automatically on 404/400.
TRT_GEMINI_IMAGE_MODEL=gemini-3-pro-image
TRT_GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image

# ── YouTube Data API v3 — competitor search, stats, channel data ────────────
# Without this key single-video lookups still work via oEmbed + thumbnail CDN,
# and competitor sets fall back to a deterministic niche model.
YOUTUBE_API_KEY=

# ── Supabase — shared schema + auth with the main TubeRadar SaaS ────────────
# Omit all three to use the bundled local JSON store under .data/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for rendered thumbnails (created by the migration).
TRT_STORAGE_BUCKET=tuberadar-thumbnails

# ── Billing (upgrade tier) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the Thumbnails upgrade tiers.
STRIPE_PRICE_THUMBS_CREATOR=
STRIPE_PRICE_THUMBS_STUDIO=
STRIPE_PRICE_THUMBS_AGENCY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Local dev conveniences ──────────────────────────────────────────────────
# Plan to grant the local dev user: free | creator | studio | agency
TRT_DEV_PLAN=studio
